{
  "name": "dkkb",
  "version": "0.1.0",
  "private": true,
  "description": "Daniel Kindl Knowledge Base: a public, version-controlled software engineering knowledge base.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\"",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:links": "node scripts/validate-built-links.mjs",
    "audit:sources": "node scripts/audit-sources.mjs",
    "audit:accessibility": "node scripts/check-accessibility.mjs",
    "check:accessibility": "pnpm build && pnpm audit:accessibility",
    "check:external-links": "node scripts/check-external-links.mjs",
    "report:freshness": "node scripts/report-freshness.mjs",
    "report:orphans": "node scripts/report-orphans.mjs",
    "test": "vitest run",
    "check": "pnpm validate:content && pnpm lint:markdown && pnpm test && pnpm build && pnpm validate:links && pnpm audit:accessibility"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.4",
    "astro-mermaid": "2.2.0",
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.24.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
