---
import { getCollection } from 'astro:content';
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import MermaidFlowchartViewport from './MermaidFlowchartViewport.astro';
import EntryGrid from './EntryGrid.astro';
import GlossaryBrowser from './GlossaryBrowser.astro';
import {
  selectHomepageSections,
  selectCategoryEntries,
  selectRelatedEntries,
} from '../lib/entries';
import {
  selectGlossaryBacklinks,
  selectGlossaryEntries,
  type MarkdownSource,
} from '../lib/glossary';

const { entry } = Astro.locals.starlightRoute;
const docs = await getCollection('docs');
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const routeFor = (entryId) => `${baseUrl}${entryId}/`;
const toCard = (doc) => ({
  title: doc.data.title,
  href: routeFor(doc.id),
  description: doc.data.description,
});

const isHomepage = entry.data.type === 'index' && entry.data.template === 'splash';
const isGlossaryIndex = entry.id === 'glossary' && entry.data.type === 'index';
const isGlossaryTerm = entry.data.type === 'glossary';

const { startHere, featured, recent, categories } = isHomepage
  ? selectHomepageSections(docs)
  : { startHere: [], featured: [], recent: [], categories: [] };

const categoryEntries =
  entry.data.type === 'index' && !isHomepage && !isGlossaryIndex
    ? selectCategoryEntries(docs, entry)
    : [];

const glossaryEntries = isGlossaryIndex ? selectGlossaryEntries(docs) : [];
const rawMarkdown = import.meta.glob('../content/docs/**/*.md', {
  eager: true,
  import: 'default',
  query: '?raw',
}) as Record<string, string>;
const markdownSources: MarkdownSource[] = isGlossaryTerm
  ? Object.entries(rawMarkdown).map(([path, content]) => ({ path, content }))
  : [];
const glossaryBacklinks = isGlossaryTerm
  ? selectGlossaryBacklinks(docs, markdownSources, entry.id)
  : [];
const relatedEntries = selectRelatedEntries(docs, entry);
---

<Default>
  <slot />

  <EntryGrid heading="Start here" headingId="start-here" entries={startHere.map(toCard)} />
  <EntryGrid heading="Featured" headingId="featured" entries={featured.map(toCard)} />
  <EntryGrid
    heading="Recently reviewed"
    headingId="recently-reviewed"
    entries={recent.map(toCard)}
  />
  <EntryGrid
    heading="Explore the knowledge base"
    headingId="explore-knowledge-base"
    entries={categories.map(toCard)}
  />
  <EntryGrid
    heading={`Entries (${categoryEntries.length})`}
    headingId="entries"
    entries={categoryEntries.map(toCard)}
  />
  <GlossaryBrowser
    entries={glossaryEntries.map((doc) => ({
      title: doc.data.title,
      href: routeFor(doc.id),
      description: doc.data.description,
      aliases: doc.data.aliases ?? [],
    }))}
  />
  <EntryGrid
    heading="Used in DKKB"
    headingId="used-in-dkkb"
    entries={glossaryBacklinks.map(toCard)}
  />
  <EntryGrid
    heading="Related knowledge"
    headingId="related-knowledge"
    entries={relatedEntries.map(toCard)}
  />
</Default>

<MermaidFlowchartViewport />
