---
import { buildSearchMetadata } from '../lib/search-metadata';

const { entry } = Astro.props;
const metadata = buildSearchMetadata({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  status: entry.data.status,
  hidden: entry.data.sidebar?.hidden === true,
  aliases: entry.data.aliases ?? [],
  topics: entry.data.topics ?? [],
});
---

{metadata && (
  <div hidden aria-hidden="true" data-pagefind-ignore>
    <span data-pagefind-meta="title">{metadata.title}</span>
    <span data-pagefind-meta="description">{metadata.description}</span>
    <span data-pagefind-meta="entry_id">{metadata.id}</span>
    {metadata.aliases.length > 0 && (
      <span data-pagefind-meta="aliases">{metadata.aliases.join(' ')}</span>
    )}
    {metadata.topics.length > 0 && (
      <span data-pagefind-meta="topics">{metadata.topics.join(' ')}</span>
    )}
  </div>
)}
